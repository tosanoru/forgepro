# Neon Postgres connection string (Neon dashboard → Connection Details).
DATABASE_URL="postgresql://neondb_owner:npg_z6fvtxOR3oQl@ep-sparkling-salad-at41awzy-pooler.c-9.us-east-1.aws.neon.tech/forgepro?sslmode=require&channel_binding=require"

# Auth.js v5 — generate with `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials).
# Redirect URI: <your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AES-256-GCM passphrase used to encrypt workspace BYOK API keys at rest.
# Generate with `openssl rand -base64 32`. Rotating this invalidates every
# saved key (workspaces would need to re-enter them) — treat it like a
# real secret, back it up somewhere safe.
ENCRYPTION_KEY=

# Server-side fallback AI key — used for script generation when a
# workspace hasn't set its own BYOK key in Settings. Optional but
# recommended so the product works before anyone's configured BYOK.
ANTHROPIC_API_KEY=

# Mux (Video Review) — dashboard.mux.com → Settings → Access Tokens.
# Needs Mux Video (read/write) permission.
MUX_TOKEN_ID='ba0d5aea-12c4-4bf5-bf83-dcd1f4b19999'
MUX_TOKEN_SECRET="kM8ypkiodByrbUg26eC2pAyRN9Qox81rRn+JNFaS1wHQDcc/1wsBC9/m04cLqsxOLvCKsGtnUmL"
# Mux dashboard → Settings → Webhooks → your endpoint's signing secret.
# Point the webhook at <your-domain>/api/mux/webhook, subscribed to at
# least: video.upload.asset_created, video.asset.ready, video.asset.errored.
MUX_WEBHOOK_SECRET="ug5eq0k2p86bfofp8qvmtagf18i8p3rs"

# Cloudflare R2 (Brand Assets) — Cloudflare dashboard → R2 → Manage API
# tokens. Bucket should be private (not public-read); all access goes
# through short-lived presigned URLs, not permanent public links.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Cron-triggered jobs — protects GET /api/cron/* routes (revenue sync,
# and now the four Niche Finder pipeline jobs) from being called by
# anyone but a scheduler. Generate with `openssl rand -hex 32`. If
# deploying to Vercel, set this in the project's env vars and Vercel
# automatically sends it as `Authorization: Bearer $CRON_SECRET` on the
# schedules defined in vercel.json — no extra wiring needed. On any other
# host, point your own scheduler (GitHub Actions, cron-job.org, etc.) at
# each endpoint with that header set manually.
CRON_SECRET=

# Niche Finder — YouTube Data API v3 key (console.cloud.google.com → APIs
# & Services → Credentials → API Key, then enable "YouTube Data API v3").
# Plain API key, NOT OAuth — same "public Data API, not the analytics
# OAuth scope" posture as the rest of this app (see Revenue Dashboard's
# YouTube note below). Default quota is 10,000 units/day; channels.list
# costs 1 unit per call (batched up to 50 IDs), search.list costs 100 —
# see CLAUDE.md for the quota budget the snapshot/discovery crons assume.
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Forge 2's OWN platform billing (Settings → Billing, upgrading a workspace
# to Lite/Pro) — a COMPLETELY SEPARATE Stripe account/integration from the
# BYOK Stripe key a workspace connects under Revenue to bill ITS OWN
# clients. Do not confuse the two: this is Forge 2 charging a workspace;
# that one is a workspace charging someone else. dashboard.stripe.com (a
# NEW/different Stripe account than whatever a workspace might BYOK) →
# Developers → API keys.
STRIPE_SECRET_KEY=
# Developers → Webhooks → add endpoint at <your-domain>/api/billing/webhook,
# subscribed to: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted. Copy the endpoint's signing secret here.
STRIPE_WEBHOOK_SECRET=
# Product catalog → create two recurring Products (Lite $19/mo, Pro
# $49/mo, or whatever pricing you land on — src/lib/plan-limits.ts has the
# actual limits, adjust priceUsdMonthly there to match whatever you set
# here) → copy each Price's id (starts with `price_`).
STRIPE_PRICE_ID_LITE=
STRIPE_PRICE_ID_PRO=

# Invite emails (optional — invites still work without this, they just
# don't notify the invitee by email; see src/lib/invite-email.ts). Get a
# key at resend.com, verify a sending domain, then set the from address
# to something on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Revenue Dashboard needs no new server env vars — Stripe, Paystack, and
# Flutterwave are all BYOK (each workspace connects its own key in
# Settings, encrypted with ENCRYPTION_KEY above, one row per provider so a
# workspace can run more than one at once). YouTube ad revenue is NOT
# integrated — see CLAUDE.md for why (yt-analytics-monetary.readonly
# requires a Google CASA security assessment before production use).
#
# Thumbnail Generation also needs no new server env var — it's BYOK too,
# a dedicated OpenAI key connected per-workspace (separate from whatever
# key powers AI Script Writing, since not every script-writing provider
# generates images).
#
# Niche Finder's MCP server (api/mcp/niche-finder) needs no separate env
# var beyond ENCRYPTION_KEY / YOUTUBE_API_KEY above — MCP keys are
# hashed, not encrypted (src/lib/mcp-auth.ts), so there's nothing else to
# configure. Its tiering reuses the existing `workspace.plan` column —
# there is NO real billing flow that sets it to anything but "free" yet.
# See CLAUDE.md.
#
# All eight modules from the original brief, plus Niche Finder, are built.
# ---------------------------------------------------------------------------
